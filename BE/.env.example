# Copy thành .env rồi chỉnh giá trị. KHÔNG commit file .env.
DATABASE_URL=postgresql+asyncpg://todo_user:todo_pass@localhost:5433/todo_db
SQL_ECHO=false

# Bắt buộc, không có mặc định. Sinh khóa: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=zHV4ew9V3bJe3eQK6so7JtlChIkTovW5NwHi__HUlzI
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Nguồn được phép gọi API, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Múi giờ để tính "hôm nay", quá hạn, sinh task habit
APP_TIMEZONE=Asia/Ho_Chi_Minh

# AI dùng API tương thích OpenAI. Không commit API key thật.
# Thiếu các biến này thì phần Habit/weekly review AI báo chưa cấu hình; phần còn lại vẫn chạy.
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=30
